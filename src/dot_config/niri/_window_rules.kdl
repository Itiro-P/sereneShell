// Window rules

window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
	blur true
    }
}

window-rule {
    match is-focused=true
    opacity 0.95
}

window-rule {
    match is-focused=false
    opacity 0.9
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"zen"# title="^Picture-in-Picture$"
    match app-id=r#"xdg-desktop-portal-gtk$"#
    match app-id=r#"nm-connection-editor$"#
    match app-id=r#"pavucontrol-qt"#
    match app-id=r#"xfce-polkit$"#
    match app-id=r#"org.freedesktop.impl.portal.desktop.kde"#
    match app-id=r#"org.pulseaudio.pavucontrol$"#
    match app-id=r#"Import Savegames$"#
    match app-id=r#"qalculate-gtk$"#
    match app-id=r#"nwg-look$"#
    match title=r#"Clonar repositório — Gittyup$"#
    match title=r#"^Todos os arquivos$"#

    open-floating true
    opacity 1.0
}

window-rule {
    match app-id="^cava$"
    default-floating-position x=20 y=20 relative-to="bottom-right"
    default-column-width { fixed 400; }
    default-window-height { fixed 160; }
    open-floating true
    opacity 1.0
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=0 y=0 relative-to="bottom-right"
    open-focused false
}
