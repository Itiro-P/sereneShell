{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 1,
            "right": 2
	},
	"color": {
            "1": "#a5c8fe",
            "2": "#bcc7dc"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#a5c8fe",
            "title": "#bcc7dc",
            "output": "#e1e2e9",
            "separator": "#8d9199"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{##a5c8fe}╭────── User : {#}{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "{##a5c8fe}│ {#}System Information"
        },
        {
            "type": "os",
            "key": "{##8d9199}│  {##a5c8fe}󰍹 OS"
        },
        {
            "type": "kernel",
            "key": "{##8d9199}│  {##a5c8fe}󰒋 Kernel"
        },
        {
            "type": "uptime",
            "key": "{##8d9199}│  {##a5c8fe}󰅐 Uptime"
        },
        {
            "type": "packages",
            "key": "{##8d9199}│  {##a5c8fe}󰏓 Packages"
        },
        {
            "type": "custom",
            "format": "{##8d9199}│"
        },
        // Desktop Environment
        {
            "type": "custom",
            "format": "{##a5c8fe}│ {#}Desktop Environment"
        },
        {
            "type": "de",
            "key": "{##8d9199}│  {##a5c8fe}󰧨 DE"
        },
        {
            "type": "wm",
            "key": "{##8d9199}│  {##a5c8fe}󱂬 WM"
        },
        {
            "type": "wmtheme",
            "key": "{##8d9199}│  {##a5c8fe}󰉼 Theme"
        },
        {
            "type": "shell",
            "key": "{##8d9199}│  {##a5c8fe}󰞷 Shell"
        },
        {
            "type": "custom",
            "format": "{##8d9199}│"
        },
        // Hardware Information
        {
            "type": "custom",
            "format": "{##a5c8fe}│ {#}Hardware Information"
        },
        {
            "type": "cpu",
            "key": "{##8d9199}│  {##a5c8fe}󰻠 CPU"
        },
        {
            "type": "gpu",
            "key": "{##8d9199}│  {##a5c8fe}󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "{##8d9199}│  {##a5c8fe}󰍛 Memory"
        },
        {
            "type": "swap",
            "key": "{##8d9199}│  {##a5c8fe}󰍛 Swap"
        },
        {
            "type": "disk",
            "key": "{##8d9199}│  {##a5c8fe}󰋊 Disk (/)",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "{##8d9199}│"
        },
        // Colors
        {
            "type": "colors",
            "key": "{##8d9199}│",
            "symbol": "circle"
        },
        // Footer
        {
            "type": "custom",
            "format": "{##8d9199}╰───────────────────────────────╯"
        }
    ]
}
