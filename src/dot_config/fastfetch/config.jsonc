{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 1,
            "right": 2
	},
	"color": {
            "1": "#d5bbfc",
            "2": "#cec2db"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#d5bbfc",
            "title": "#cec2db",
            "output": "#e7e0e8",
            "separator": "#958e99"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{##d5bbfc}╭────── User : {#}{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "{##d5bbfc}│ {#}System Information"
        },
        {
            "type": "os",
            "key": "{##958e99}│  {##d5bbfc}󰍹 OS"
        },
        {
            "type": "kernel",
            "key": "{##958e99}│  {##d5bbfc}󰒋 Kernel"
        },
        {
            "type": "uptime",
            "key": "{##958e99}│  {##d5bbfc}󰅐 Uptime"
        },
        {
            "type": "packages",
            "key": "{##958e99}│  {##d5bbfc}󰏓 Packages"
        },
        {
            "type": "custom",
            "format": "{##958e99}│"
        },
        // Desktop Environment
        {
            "type": "custom",
            "format": "{##d5bbfc}│ {#}Desktop Environment"
        },
        {
            "type": "de",
            "key": "{##958e99}│  {##d5bbfc}󰧨 DE"
        },
        {
            "type": "wm",
            "key": "{##958e99}│  {##d5bbfc}󱂬 WM"
        },
        {
            "type": "wmtheme",
            "key": "{##958e99}│  {##d5bbfc}󰉼 Theme"
        },
        {
            "type": "shell",
            "key": "{##958e99}│  {##d5bbfc}󰞷 Shell"
        },
        {
            "type": "custom",
            "format": "{##958e99}│"
        },
        // Hardware Information
        {
            "type": "custom",
            "format": "{##d5bbfc}│ {#}Hardware Information"
        },
        {
            "type": "cpu",
            "key": "{##958e99}│  {##d5bbfc}󰻠 CPU"
        },
        {
            "type": "gpu",
            "key": "{##958e99}│  {##d5bbfc}󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "{##958e99}│  {##d5bbfc}󰍛 Memory"
        },
        {
            "type": "swap",
            "key": "{##958e99}│  {##d5bbfc}󰍛 Swap"
        },
        {
            "type": "disk",
            "key": "{##958e99}│  {##d5bbfc}󰋊 Disk (/)",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "{##958e99}│"
        },
        // Colors
        {
            "type": "colors",
            "key": "{##958e99}│",
            "symbol": "circle"
        },
        // Footer
        {
            "type": "custom",
            "format": "{##958e99}╰───────────────────────────────╯"
        }
    ]
}
