 * Rofi Theme File
 * Rofi Version: 1.7.3
 * Modified to use matugen variables
 **/

/*****----- Import matugen colors -----*****/
@import "colors.rasi"

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
* {
    font:                        "monospace 12";
    background:                  @surface;
    background-alt:              @surface-container;
    foreground:                  @on-surface;
    selected:                    @primary;
    active:                      @secondary;
    urgent:                      @error;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    padding:                     0px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               20px;
    cursor:                      "default";
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     20px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     80px 60px;   
    border-radius:               0px 0px 20px 20px;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 horizontal;
    children:                    [ "entry" ];
}

entry {
    enabled:                     true;
    expand:                      true;
    width:                       250px;
    padding:                     12px 16px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           @on-surface-variant;
}

button {
    width:                       48px;
    padding:                     12px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  @on-surface-variant;
    cursor:                      pointer;
    horizontal-align:            0.5;
    vertical-align:              0.5;
}

button selected {
    background-color:            @selected;
    text-color:                  @on-primary;
}

/*****----- Listview -----*****/
listview {
    border:                      0px;
    enabled:                     true;
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
   
    padding:                     16px;
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     4px;
    border-radius:               100%;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            transparent;
    text-color:                  @on-surface;
}
element normal.urgent {
    background-color:            @error-container;
    text-color:                  @on-error-container;
}
element normal.active {
    background-color:            @secondary-container;
    text-color:                  @on-secondary-container;
}
element selected.normal {
    background-color:            @primary-container;
    text-color:                  @on-primary-container;
}
element selected.urgent {
    background-color:            @error-container;
    text-color:                  @on-error-container;
}
element selected.active {
    background-color:            @tertiary-container;
    text-color:                  @on-tertiary-container;
}
element alternate.normal {
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
}
element alternate.urgent {
    background-color:            @error-container;
    text-color:                  @on-error-container;
}
element alternate.active {
    background-color:            @secondary-container;
    text-color:                  @on-secondary-container;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}
textbox {
    padding:                     12px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     12px;
    border-radius:               20px;
    background-color:            @surface-container-high;
    text-color:                  @on-surface;
}
